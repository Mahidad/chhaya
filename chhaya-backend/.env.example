# Copy this file to .env and fill in real values. .env is gitignored.
# Never commit real secrets to version control.

ENV=development

# PostgreSQL connection string (psycopg v3 / libpq DSN format).
# Pattern: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Example for a local dev DB with no password (common with pg_hba "trust"):
DATABASE_URL=postgresql://postgres@localhost:5432/chhaya

# For a password-protected local DB:
# DATABASE_URL=postgresql://chhaya_user:supersecret@localhost:5432/chhaya

# Setup steps (one-time):
#   createdb chhaya                               # create the database
#   psql -U postgres -d chhaya -f sql/schema.sql  # apply the schema

JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Leave blank to use the mock style-profile response while you build.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
