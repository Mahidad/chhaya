# Copy this file to .env and fill in real values. .env is gitignored.
# Never commit real secrets to version control.

ENV=development

# PostgreSQL connection string (psycopg v3 / libpq DSN format).
# Pattern: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Example for a local dev DB with no password (common with pg_hba "trust"):
DATABASE_URL=postgresql://postgres@localhost:5432/chhaya

# For a password-protected local DB:
# DATABASE_URL=postgresql://chhaya_user:supersecret@localhost:5432/chhaya

# Setup steps (one-time):
#   createdb chhaya                               # create the database
#   psql -U postgres -d chhaya -f sql/schema.sql  # apply the schema

JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Leave blank to use the mock style-profile response while you build.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
# --- Code Studio practice bank ---
# The dev server imports this dataset by itself the first time it finds the
# problem bank empty, so there is normally nothing to run. You only need a
# Kaggle API token: kaggle.com -> Settings -> API -> Create New Token, saved to
# ~/.kaggle/kaggle.json (or set KAGGLE_USERNAME and KAGGLE_KEY).
#
# Change the slug to use a different dataset; set PRACTICE_AUTO_IMPORT=false to
# turn the automatic import off and run scripts/import_practice_problems.py by
# hand instead.
PRACTICE_DATASET_SLUG=gzipchrist/leetcode-problem-dataset
PRACTICE_AUTO_IMPORT=true

