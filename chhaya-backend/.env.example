# Copy this file to .env and fill in real values. .env is gitignored.

ENV=development

# SQLite for local dev (zero setup). Switch to Postgres for anything shared:
# DATABASE_URL=postgresql+psycopg2://chhaya:chhaya@localhost:5432/chhaya
DATABASE_URL=sqlite:///./chhaya.db

JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Leave blank to use the mock style-profile response while you build.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
